#version 450
#extension GL_EXT_samplerless_texture_functions : require
// Upscale pass for the window's UPSCALER row. Mode 1 is Catmull-Rom; mode 2 is the
// FSR1-path EASU stand-in: the same Catmull-Rom kernel, with each result clamped to the
// 2x2 texels nearest the sample point so it cannot ring past the local range.
// Compile command and SPIR-V embedding: see upscale_spv.h.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Push {
    vec2 src_origin;    // top-left of the game's crop, in source texels
    vec2 src_extent;    // size of the game's crop, in source texels
    ivec2 dst_extent;   // size of the output, in texels
    int mode;           // 1 = Catmull-Rom, 2 = EASU path
} pc;

// Catmull-Rom weight, a = -0.5.
float cr(float x) {
    x = abs(x);
    if (x < 1.0) return 1.5 * x * x * x - 2.5 * x * x + 1.0;
    if (x < 2.0) return -0.5 * x * x * x + 2.5 * x * x - 4.0 * x + 2.0;
    return 0.0;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.dst_extent.x || p.y >= pc.dst_extent.y) return;

    // The crop is the game's visible area; sample centres map onto it.
    vec2 scale = pc.src_extent / vec2(pc.dst_extent);
    vec2 s = pc.src_origin + (vec2(p) + 0.5) * scale - 0.5;
    ivec2 base = ivec2(floor(s));
    vec2 f = s - vec2(base);

    // Clamp taps to the crop, so the border does not pull in pixels outside the game image.
    ivec2 tex = textureSize(src, 0);
    ivec2 lo = clamp(ivec2(floor(pc.src_origin)), ivec2(0), tex - 1);
    ivec2 hi = clamp(ivec2(ceil(pc.src_origin + pc.src_extent)) - 1, lo, tex - 1);

    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    vec3 near_lo = vec3(1.0);
    vec3 near_hi = vec3(0.0);
    for (int j = 0; j < 4; ++j) {
        float wy = cr(f.y - float(j - 1));
        for (int i = 0; i < 4; ++i) {
            float w = cr(f.x - float(i - 1)) * wy;
            vec3 c = texelFetch(src, clamp(base + ivec2(i - 1, j - 1), lo, hi), 0).rgb;
            sum += c * w;
            wsum += w;
            // Tap indices 1..2 on both axes are the 2x2 texels around the sample point.
            if (i == 1 || i == 2) {
                if (j == 1 || j == 2) {
                    near_lo = min(near_lo, c);
                    near_hi = max(near_hi, c);
                }
            }
        }
    }

    vec3 col = sum / wsum;
    if (pc.mode == 2) col = clamp(col, near_lo, near_hi);
    imageStore(dst, p, vec4(clamp(col, 0.0, 1.0), 1.0));
}
